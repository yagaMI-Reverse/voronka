# ---------------------------------------------------------------------------
# Voronka — конфигурация. Скопировать в .env и заполнить.
# РЕАЛЬНЫЕ КЛЮЧИ В GIT НЕ КОММИТИТЬ (.env в .gitignore).
# ---------------------------------------------------------------------------

# --- Куда складывать журнал/очередь ---
VORONKA_DB=voronka.db

# --- amoCRM ---
# Базовый URL аккаунта. Для прогонов против мока: http://127.0.0.1:8081
AMO_BASE_URL=http://127.0.0.1:8081

# Режим авторизации:
#   long_lived — долгосрочный токен (выдаётся в карточке интеграции, 1 день…5 лет,
#                показывается ОДИН раз). Проще всего для приватной интеграции.
#   oauth      — классический OAuth2 authorization_code + refresh_token.
AMO_AUTH_MODE=long_lived

# Для AMO_AUTH_MODE=long_lived
AMO_LONG_LIVED_TOKEN=paste-long-lived-token-here

# Для AMO_AUTH_MODE=oauth
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://example.com/amo/callback
# Одноразовый код авторизации: обменивается на пару токенов при первом старте,
# после обмена строку можно очистить (токены лягут в БД).
AMO_AUTH_CODE=

# --- Куда класть сделку ---
# ID воронки и статуса «Неразобранное»/первого этапа. Узнать: GET /api/v4/leads/pipelines
AMO_PIPELINE_ID=
AMO_STATUS_NEW=
# Статус, в который переводим сделку после квалификации ботом
AMO_STATUS_QUALIFIED=
AMO_STATUS_REJECTED=

# ID кастомных полей сделки (GET /api/v4/leads/custom_fields)
AMO_CF_SOURCE=
AMO_CF_BUDGET=
AMO_CF_TIMELINE=
AMO_CF_TELEGRAM=

# --- Слой надёжности ---
# Максимум попыток доставки, после чего событие уходит в DLQ
RETRY_MAX_ATTEMPTS=6
# Базовая задержка backoff в секундах: delay = base * 2^(attempt-1) + jitter
RETRY_BASE_SECONDS=1.0
RETRY_MAX_SECONDS=60.0
# Полный джиттер (AWS full jitter). 0 — детерминированный backoff (для тестов)
RETRY_JITTER=1

# Период опроса outbox воркером, секунды
WORKER_TICK_SECONDS=0.25
# HTTP-таймаут до amoCRM, секунды
AMO_TIMEOUT_SECONDS=10.0

# --- Приём вебхуков ---
# Общий секрет: BotHelp/форма шлют его в заголовке X-Voronka-Token.
# Пусто = проверка выключена (только для локальных прогонов).
VORONKA_WEBHOOK_TOKEN=
